[Unit]
Description=Recast (YouTube video to article)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@RECAST_CHECKOUT@
# Generated by deploy/install.sh using the checkout and Bun locations.
Environment="PATH=@BUN_DIRECTORY@:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
# Credentials and per-machine paths: outside the repository, mode 600. The leading "-" tolerates a missing file (the UI then warns).
EnvironmentFile=-%h/.config/recast/recast.env
ExecStart="@BUN_EXECUTABLE@" src/server/main.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
