# Recast configuration. Never commit the real file.
#   systemd: copy to ~/.config/recast/recast.env (chmod 600)
#   Docker:  copy to .env next to compose.yaml

# Address used in e-mail links: how you reach Recast from where you read your e-mail.
RECAST_BASE_URL=http://localhost:4280
# Interface to listen on (default 127.0.0.1, this machine only). Use 0.0.0.0 to accept connections
# from other machines; Recast has no authentication, so only do it on a trusted private network.
#RECAST_HOST=127.0.0.1
#RECAST_PORT=4280
# Data (database, audio, logs). Default: ~/.local/share/recast
#RECAST_DATA_DIR=

# E-mail delivery (Gmail with an app password: https://support.google.com/accounts/answer/185833)
RECAST_SMTP_USER=
RECAST_SMTP_PASSWORD=
# Another provider: its SMTP server and port (465 uses TLS, other ports STARTTLS). The sender is RECAST_SMTP_USER.
#RECAST_SMTP_HOST=smtp.gmail.com
#RECAST_SMTP_PORT=465

# Article generation: configure at least one provider, then pick it in Settings. See docs/generation.md.
# GitHub Copilot: a fine-grained PAT with "Copilot Requests" (or the output of `gh auth token`).
# Leave empty to use the gh login of the user running the service.
COPILOT_GITHUB_TOKEN=
# Claude: an Anthropic API key, or your own Claude subscription. A key takes precedence.
ANTHROPIC_API_KEY=
# Subscription: the token printed by `claude setup-token`. Without Docker, leave both empty to reuse
# the service user's Claude Code login. For your own, individual use only; see docs/generation.md.
#CLAUDE_CODE_OAUTH_TOKEN=
# Codex: leave empty to reuse `codex login` of the service user. An API key takes precedence over it.
#CODEX_API_KEY=
#OPENAI_API_KEY=
#CODEX_HOME=/path/to/.codex
#CODEX_CLI_PATH=/path/to/codex

# Tools, only when they are not on PATH (the Docker image already has all of them).
#YT_DLP_PATH=/usr/bin/yt-dlp
# JavaScript runtime yt-dlp uses for YouTube challenges (default: node), e.g. bun or node:/path/to/node
#RECAST_JS_RUNTIME=node
#FFMPEG_PATH=/usr/bin/ffmpeg
#WHISPER_CLI_PATH=/usr/local/bin/whisper-cli
# Default: ~/.local/share/recast/models/ggml-large-v3-turbo.bin
#WHISPER_MODEL=/path/to/ggml-large-v3-turbo.bin
#COPILOT_CLI_PATH=/path/to/copilot

# Optional: bind every YouTube request (RSS and yt-dlp) to this local IPv4 address, for hosts
# whose VPN blocks YouTube. Requires curl and a host routing rule; see docs/service.md.
#RECAST_YOUTUBE_SOURCE_ADDRESS=192.168.1.10
